# Salin menjadi .env di SERVER. Jangan commit .env atau membagikan token.
PORT=3000
HOST=127.0.0.1
DATA_FILE=./data/agana-wa.json
WA_PHONE_NUMBER_ID=ID_NOMOR_META
WA_ACCESS_TOKEN=TOKEN_META_DARI_WHATSAPP_BUSINESS_PLATFORM
WA_VERIFY_TOKEN=GANTI_DENGAN_TOKEN_ACAK_MINIMAL_16
WA_APP_SECRET=APP_SECRET_DARI_META_MINIMAL_16
WA_GRAPH_VERSION=v24.0
ADMIN_TOKEN=GANTI_DENGAN_TOKEN_ADMIN_ACAK_PANJANG_MINIMAL_24
AI_PROVIDER=groq
AI_API_KEY=KUNCI_DARI_PENYEDIA_AI_DI_SERVER
AI_MODEL=openai/gpt-oss-20b
# Informasi toko yang boleh disampaikan AI. Jangan mencantumkan data pribadi pelanggan.
SHOP_FACTS_JSON={"nama":"AGAN PONSEL","layanan":["Service HP","Aksesoris","Pulsa dan paket data"],"alamat":"Isi alamat toko yang benar","jam_buka":"Isi jam layanan yang benar","catatan":"Harga dan stok harus dikonfirmasi oleh admin"}
